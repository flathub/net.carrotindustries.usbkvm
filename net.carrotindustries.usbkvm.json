{
    "app-id": "net.carrotindustries.usbkvm",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.golang"
    ],
    "command": "usbkvm",
    "finish-args": [
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=all",
        "--filesystem=xdg-run/pipewire-0:ro"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig"
    ],
    "modules": [
        "gtkmm.json",
        {
            "name": "usbkvm",
            "buildsystem": "meson",
            "build-options": {
                "prepend-path": "/usr/lib/sdk/golang/bin"
            },
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/carrotIndustries/usbkvm/releases/download/v0.3.2/usbkvm-v0.3.2.tar.gz",
                    "sha256": "66ba6895bf4d80064b33c484553e7d8c69eb57b9ffd49a8b119119f273aa7b0b",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "json",
                        "url": "https://api.github.com/repos/carrotIndustries/usbkvm/releases/latest",
                        "version-query": ".tag_name | sub(\"^v\"; \"\")",
                        "url-query": ".assets[] | select(.name==\"usbkvm-v\" + $version + \".tar.gz\") | .browser_download_url"
                    }
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/carrotIndustries/usbkvm/refs/heads/main/app/LICENSE",
                    "sha256": "589ed823e9a84c56feb95ac58e7cf384626b9cbf4fda2a907bc36e103de1bad2"
                }
            ]
        }
    ]
}
